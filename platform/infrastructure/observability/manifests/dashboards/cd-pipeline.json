    {
      "type": "table",
      "title": "Recent promotions",
      "description": "Newest first. Commit = the env-branch commit (empty when the promotion failed before pushing). Run = the GitHub Actions run of a gha deploy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_cluster_name=\"hub\"} | namespace=\"promotion-log\" | json | msg=\"promotion\" | system=\"$system\" | app=\"$app\"",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "Failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Promoted by"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^system:serviceaccount:kargo:kargo-controller.*$",
                      "result": {
                        "text": "automatic",
                        "color": "blue",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "automatic",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "GitHub Actions run",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kargo"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Kargo",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^https.*$",
                      "result": {
                        "text": "open",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Received",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "receivedAt": true,
              "stage": true,
              "target": true,
              "platform": true,
              "deployWith": true,
              "result": true,
              "actor": true,
              "freightAlias": true,
              "artifact": true,
              "commit": true,
              "ghaRunURL": true,
              "uiURL": true
            },
            "indexByName": {
              "receivedAt": 0,
              "stage": 1,
              "target": 2,
              "platform": 3,
              "deployWith": 4,
              "result": 5,
              "actor": 6,
              "freightAlias": 7,
              "artifact": 8,
              "commit": 9,
              "ghaRunURL": 10,
              "uiURL": 11
            },
            "renameByName": {
              "receivedAt": "Received",
              "stage": "Stage",
              "target": "Target",
              "platform": "Platform",
              "deployWith": "Deployed by",
              "result": "Result",
              "actor": "Promoted by",
              "freightAlias": "Freight",
              "artifact": "Artifact",
              "commit": "Commit",
              "ghaRunURL": "Run",
              "uiURL": "Kargo"
            }
          }
        }
      ],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Promotions over time",
      "description": "Recorded promotions per target and result.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (target, result) (count_over_time({k8s_cluster_name=\"hub\"} | namespace=\"promotion-log\" | json | msg=\"promotion\" | system=\"$system\" | app=\"$app\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{target}} {{result}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
