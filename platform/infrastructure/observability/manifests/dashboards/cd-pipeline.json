          "expr": "histogram_quantile(0.95, sum by (le, stepKind) (clamp_min(kargo_promotion_step_duration_seconds_bucket{project=\"kargo-$system-$app\"} - (kargo_promotion_step_duration_seconds_bucket{project=\"kargo-$system-$app\"} offset $__range * 1 or kargo_promotion_step_duration_seconds_bucket{project=\"kargo-$system-$app\"} * 0), 0)))",
