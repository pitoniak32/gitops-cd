      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stepKind, terminalStatus) (clamp_min(kargo_promotion_step_duration_seconds_count{project=\"kargo-$system-$app\"} - (kargo_promotion_step_duration_seconds_count{project=\"kargo-$system-$app\"} offset $__range * 1 or kargo_promotion_step_duration_seconds_count{project=\"kargo-$system-$app\"} * 0), 0)) > 0",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
