    },
    {
      "type": "timeseries",
      "title": "Promotion duration",
      "description": "Start to finish, all results.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (clamp_min(kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\"} - (kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\"} offset $__rate_interval * 1 or kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\"} * 0), 0)))",
          "refId": "A",
          "legendFormat": "p50",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (clamp_min(kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\"} - (kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\"} offset $__rate_interval * 1 or kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\"} * 0), 0)))",
          "refId": "B",
          "legendFormat": "p95",
          "format": "time_series"
