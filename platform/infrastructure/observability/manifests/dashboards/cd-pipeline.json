{
  "uid": "cd-pipeline",
  "title": "CD pipeline",
  "description": "One app's path to production: Kargo promotions and the Argo CD targets they deploy (ADR 0031).",
  "tags": [
    "cd",
    "kargo",
    "argocd"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "system",
        "label": "System",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(argocd_app_labels, label_example_com_system)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(argocd_app_labels, label_example_com_system)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(argocd_app_labels{label_example_com_system=\"$system\"}, label_example_com_app)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(argocd_app_labels{label_example_com_system=\"$system\"}, label_example_com_app)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Kargo project",
      "type": "link",
      "url": "https://kargo.localhost/project/kargo-${system}-${app}",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Overview (selected time range)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Successful promotions",
      "description": "Promotions that finished Succeeded, across all stages.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(clamp_min(kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase=\"Succeeded\"} - (kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase=\"Succeeded\"} offset $__range * 1 or kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase=\"Succeeded\"} * 0), 0)) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failed promotions",
      "description": "Promotions that ended Failed, Errored or Aborted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(clamp_min(kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase!=\"Succeeded\"} - (kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase!=\"Succeeded\"} offset $__range * 1 or kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase!=\"Succeeded\"} * 0), 0)) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Promotion success rate",
      "description": "Succeeded / all finished promotions. Empty when nothing finished in the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(clamp_min(kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase=\"Succeeded\"} - (kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase=\"Succeeded\"} offset $__range * 1 or kargo_promotions_completed_total{project=\"kargo-$system-$app\", phase=\"Succeeded\"} * 0), 0)) / sum(clamp_min(kargo_promotions_completed_total{project=\"kargo-$system-$app\"} - (kargo_promotions_completed_total{project=\"kargo-$system-$app\"} offset $__range * 1 or kargo_promotions_completed_total{project=\"kargo-$system-$app\"} * 0), 0))",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Median promotion time",
      "description": "Median time from a promotion starting to it succeeding (bucketed: 30s, 1m, 2m, 5m, 10m, 30m, 1h).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (clamp_min(kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\", phase=\"Succeeded\"} - (kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\", phase=\"Succeeded\"} offset $__range * 1 or kargo_promotion_duration_seconds_bucket{project=\"kargo-$system-$app\", phase=\"Succeeded\"} * 0), 0)))",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Promotions in flight",
      "description": "Pending or Running right now. Stays above 0 for long = stuck promotion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kargo_promotions_non_terminal{project=\"kargo-$system-$app\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Targets not healthy",
      "description": "Argo CD Applications of this app whose health is not Healthy (GitHub Actions targets not included).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((argocd_app_info{health_status!=\"Healthy\"} * on (name, k8s_cluster_name) group_left(label_example_com_stage, label_example_com_target) argocd_app_labels{label_example_com_system=\"$system\", label_example_com_app=\"$app\"})) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 7
    },
    {
      "type": "row",
      "title": "Targets deployed by Argo CD",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "id": 8
    },
    {
      "type": "table",
      "title": "Target status",
      "description": "Health and sync of this app's targets that Argo CD deploys. Targets with deployWith: gha (and every TERRAFORM / CLOUD_RUN target) deploy via GitHub Actions and are not listed. Shows what runs in the cluster: after a cluster rebuild a target can be Healthy here while Kargo shows no Freight until `gcd kargo-restore`.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (label_example_com_stage, label_example_com_target, k8s_cluster_name, health_status, sync_status) (argocd_app_info * on (name, k8s_cluster_name) group_left(label_example_com_stage, label_example_com_target) argocd_app_labels{label_example_com_system=\"$system\", label_example_com_app=\"$app\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": {
                        "color": "green",
                        "index": 0
                      },
                      "Progressing": {
                        "color": "blue",
                        "index": 1
                      },
                      "Degraded": {
                        "color": "red",
                        "index": 2
                      },
                      "Missing": {
                        "color": "orange",
                        "index": 3
                      },
                      "Suspended": {
                        "color": "purple",
                        "index": 4
                      },
                      "Unknown": {
                        "color": "gray",
                        "index": 5
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sync"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced": {
                        "color": "green",
                        "index": 0
                      },
                      "OutOfSync": {
                        "color": "orange",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "gray",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Stage",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "label_example_com_stage": 0,
              "label_example_com_target": 1,
              "k8s_cluster_name": 2,
              "health_status": 3,
              "sync_status": 4
            },
            "renameByName": {
              "label_example_com_stage": "Stage",
              "label_example_com_target": "Target",
              "k8s_cluster_name": "Cluster",
              "health_status": "Health",
              "sync_status": "Sync"
            }
          }
        }
      ],
      "id": 9
    },
    {
      "type": "state-timeline",
      "title": "Health over time",
      "description": "Per target: green = Healthy, red = anything else.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (label_example_com_target) ((argocd_app_info{health_status!=\"Healthy\"} * 0 + 1) * on (name, k8s_cluster_name) group_left(label_example_com_stage, label_example_com_target) argocd_app_labels{label_example_com_system=\"$system\", label_example_com_app=\"$app\"}) or max by (label_example_com_target) ((argocd_app_info{health_status=\"Healthy\"} * 0) * on (name, k8s_cluster_name) group_left(label_example_com_stage, label_example_com_target) argocd_app_labels{label_example_com_system=\"$system\", label_example_com_app=\"$app\"})",
          "refId": "A",
          "legendFormat": "{{label_example_com_target}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Healthy"
                },
                "1": {
                  "text": "Not healthy"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Syncs per target",
      "description": "Argo CD sync operations (a promotion's argocd-update step triggers one).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (label_example_com_target, phase) (clamp_min(argocd_app_sync_total{dry_run=\"false\"} - (argocd_app_sync_total{dry_run=\"false\"} offset $__interval * 1 or argocd_app_sync_total{dry_run=\"false\"} * 0), 0) * on (name, k8s_cluster_name) group_left(label_example_com_stage, label_example_com_target) argocd_app_labels{label_example_com_system=\"$system\", label_example_com_app=\"$app\"})",
          "refId": "A",
          "legendFormat": "{{label_example_com_target}} {{phase}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11
    },
    {
      "type": "row",
      "title": "Promotion log (every deploy method)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": [],
      "id": 12
    },
    {
      "type": "table",
      "title": "Promotions per target (selected range)",
      "description": "Every promotion of this app per target and result, whatever deploys it (Argo CD or GitHub Actions), from the promotion-log record step (ADR 0032). Aborted promotions are not recorded.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (target, platform, deployWith, result) (count_over_time({k8s_cluster_name=\"hub\"} | namespace=\"promotion-log\" | json | msg=\"promotion\" | system=\"$system\" | app=\"$app\" [$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "Failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Promotions"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Target",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "target": 0,
              "platform": 1,
              "deployWith": 2,
              "result": 3,
              "Value #A": 4
            },
            "renameByName": {
              "target": "Target",
              "platform": "Platform",
              "deployWith": "Deployed by",
              "result": "Result",
              "Value #A": "Promotions"
            }
          }
        }
      ],
      "id": 13
    },
    {
      "type": "table",
      "title": "Who promoted (selected range)",
      "description": "automatic = Kargo auto-promotion (Freight arriving at a Stage with autoPromotionEnabled, e.g. dev after a new build): no person started it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (target, actor) (count_over_time({k8s_cluster_name=\"hub\"} | namespace=\"promotion-log\" | json | msg=\"promotion\" | system=\"$system\" | app=\"$app\" | label_format actor=`{{ if eq .automatic \"true\" }}automatic{{ else }}{{ .actor }}{{ end }}` [$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
