#!/usr/bin/env bash
#MISE description="Restore Kargo's record of what runs where after a cluster rebuild, from the env/* branches (idempotent)"
#USAGE arg "[caps]..." help="capabilities to restore (default: all under capabilities/)"
# Kargo keeps "current Freight per Stage" only in the hub's etcd; GitHub keeps what's deployed (env/* branches).
# For each target Stage with no current Freight: read its branch head (Kargo's commit message names the
# source commit; deployment.yaml pins <repo>:<tag>@<digest>), recreate that Freight (same artifacts ->
# same ID/alias), approve it for the Stage and promote it. The promotion re-copies identical manifests,
# so the workload doesn't change; Kargo just records it as current. Branches it can't reproduce (never
# promoted, pre-ADR-0016, hand edits) are skipped with a reason. Gate Stages are not restored.
# Runs as cluster admin (kubectl), like the other runbooks in docs/operations.md.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
. platform/bootstrap/kargo-restore-lib.sh
HUB=kind-kargo-demo
k() { kubectl --context "$HUB" "$@"; }

caps=(${usage_caps:-})
[ ${#caps[@]} -gt 0 ] || caps=($(ls capabilities))

promos=()  # <ns>/<promotion>
for cap in "${caps[@]}"; do
  ns="kargo-$cap"
  k get ns "$ns" >/dev/null 2>&1 || { echo "$cap: no Kargo project $ns (not rendered/synced yet?), skipped"; continue; }
  freights=$(k -n "$ns" get freight -o json)
  while IFS=$'\t' read -r stage wh repo branch irepo has; do
    if [ "$has" = true ]; then echo "$cap/$stage: already has Freight, skipped"; continue; fi
    slug=${repo#https://github.com/}; ref=${branch//\//%2F}
    if ! msg=$(gh api "repos/$slug/commits/$ref" --jq .commit.message 2>/dev/null); then
      echo "$cap/$stage: $branch doesn't exist (never promoted), skipped"; continue
    fi
    img=$(gh api "repos/$slug/contents/deployment.yaml?ref=$ref" --jq .content 2>/dev/null | base64 -d 2>/dev/null |
      yq '.spec.template.spec.containers[0].image // ""' 2>/dev/null || true)
    if ! fj=$(freight_json "$wh" "$repo" "$irepo" "$msg" "$img" 2>&1); then
      echo "$cap/$stage: $fj, skipped"; continue
    fi
    # existing Freight with the same artifacts (re-run, or another target of the same app) else create it
    name=$(jq -r --argjson f "$fj" '.items[] | select(.origin.name == $f.origin.name and .commits[0].id == $f.commits[0].id
      and .images[0].digest == $f.images[0].digest) | .metadata.name' <<<"$freights" | head -1)
    if [ -z "$name" ]; then
      name=$(k create --raw "/apis/kargo.akuity.io/v1alpha1/namespaces/$ns/freights" -f <(echo "$fj") | jq -r .metadata.name)
      freights=$(k -n "$ns" get freight -o json)
    fi
    # available to the target Stage without re-running the gates (same as a break-glass approval)
    k -n "$ns" patch freight "$name" --subresource=status --type=merge \
      -p "{\"status\":{\"approvedFor\":{\"$stage\":{\"approvedAt\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}}}}" >/dev/null
    p=$(jq -n --arg ns "$ns" --arg stage "$stage" --arg f "$name" \
      '{apiVersion: "kargo.akuity.io/v1alpha1", kind: "Promotion", metadata: {generateName: ($stage + "-restore-"), namespace: $ns}, spec: {stage: $stage, freight: $f}}' |
      k create -f - -o jsonpath='{.metadata.name}')
    promos+=("$ns/$p")
    echo "$cap/$stage: promoting $(jq -r '.images[0].tag + " from " + .commits[0].id[0:7]' <<<"$fj") (Freight $name)"
  done < <(k -n "$ns" get stages -o json | jq -r '.items[] | select(.spec.promotionTemplate != null) |
    (.spec.promotionTemplate.spec.vars | map({(.name): .value}) | add) as $v |
    [.metadata.name, .spec.requestedFreight[0].origin.name, $v.repo, $v.branch, $v.image,
     ((.status.freightHistory[0].items // {}) | length > 0 | tostring)] | @tsv')
done

# wait for every restore promotion; any failure fails the task
rc=0
for np in ${promos[@]+"${promos[@]}"}; do
  ns=${np%%/*} p=${np#*/}
  for i in $(seq 1 300); do
    phase=$(k -n "$ns" get promotion "$p" -o jsonpath='{.status.phase}')
    case "$phase" in Succeeded|Failed|Errored|Aborted) break ;; esac
    sleep 2
  done
  echo "$p: ${phase:-timed out}"
  [ "$phase" = Succeeded ] || { rc=1; k -n "$ns" get promotion "$p" -o jsonpath='{.status.message}{"\n"}' >&2; }
done
exit $rc
