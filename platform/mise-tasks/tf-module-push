#!/usr/bin/env bash
#MISE description="Push the example terraform module (examples/terraform/bucket) to ghcr as an OCI artifact; skips an existing tag"
#USAGE arg "[version]" default="1.0.0" help="SemVer tag"
# Optional demo step (ADR 0021): the Warehouse of payments/infra discovers these tags. Needs GITHUB_PAT
# (fnox) with write:packages. Single manifest + oras' default empty config: Kargo's image discovery
# rejects an index and fails on a non-JSON config.
set -euo pipefail
version="${usage_version:-${1:-1.0.0}}"
ref="ghcr.io/pitoniak32/tf-bucket:$version"
if oras manifest fetch "$ref" >/dev/null 2>&1; then echo "$ref exists, skipped"; exit 0; fi
fnox get GITHUB_PAT | oras login ghcr.io -u "$(gh api user --jq .login)" --password-stdin
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
tar -C "$MISE_PROJECT_ROOT/examples/terraform/bucket" -czf "$tmp/module.tgz" .
(cd "$tmp" && oras push "$ref" --artifact-type application/vnd.example.tf.module.v1 \
  module.tgz:application/vnd.example.tf.module.v1.tar+gzip)
echo "pushed $ref"
