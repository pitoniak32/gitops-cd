#!/usr/bin/env bash
#MISE description="Kargo controller shard per region: hub identity, token handoff, regional controller (idempotent)"
set -euo pipefail
# Distributed Kargo (https://docs.kargo.io/operator-guide/architecture#distributed-configuration):
# regional controllers phone home to the hub; the hub holds no credentials to regions.
# Must run after the hub `kargo` app is Healthy and each region's Argo CD exists.

HUB=kind-kargo-demo
HUB_SERVER=https://kargo-demo-control-plane:6443  # hub apiserver on docker network kargo-demo
regions=$(grep -v '^#' platform/cluster/regions)

wait_app() { # ctx app
  kubectl --context "$1" -n argocd annotate "app/$2" argocd.argoproj.io/refresh=normal --overwrite >/dev/null
  for i in $(seq 1 60); do
    [ -z "$(kubectl --context "$1" -n argocd get "app/$2" -o jsonpath='{.metadata.annotations.argocd\.argoproj\.io/refresh}')" ] && break
    sleep 2
  done
  kubectl --context "$1" -n argocd wait "app/$2" --for=jsonpath='{.status.sync.status}'=Synced --timeout=600s
  kubectl --context "$1" -n argocd wait "app/$2" --for=jsonpath='{.status.health.status}'=Healthy --timeout=600s
}

# 1. hub: shard identities (SA, RBAC, token Secret)
for r in $regions; do
  SHARD=$r mise run infra-render kargo-shard-hub | kubectl --context "$HUB" apply -f -
  wait_app "$HUB" "kargo-ctrl-$r"
done

# 2. token handoff hub -> region (host-side), then 3. regional controller
for r in $regions; do
  ctx="kind-region-$r"
  sec="kargo-controller-$r-token"
  for i in $(seq 1 30); do
    [ -n "$(kubectl --context "$HUB" -n kargo get secret "$sec" -o jsonpath='{.data.token}' 2>/dev/null)" ] && break
    [ "$i" = 30 ] && { echo "no token in kargo/$sec on hub" >&2; exit 1; }
    sleep 2
  done
  token=$(kubectl --context "$HUB" -n kargo get secret "$sec" -o jsonpath='{.data.token}' | base64 -d)
  ca=$(kubectl --context "$HUB" -n kargo get secret "$sec" -o jsonpath='{.data.ca\.crt}')
  kcfg=$(cat <<KUBECONFIG
apiVersion: v1
kind: Config
clusters:
  - name: hub
    cluster: {server: $HUB_SERVER, certificate-authority-data: $ca}
users:
  - name: kargo-controller-$r
    user: {token: $token}
contexts:
  - name: hub
    context: {cluster: hub, user: kargo-controller-$r}
current-context: hub
KUBECONFIG
)
  kubectl --context "$ctx" create namespace kargo --dry-run=client -o yaml | kubectl --context "$ctx" apply -f - >/dev/null
  old=$(kubectl --context "$ctx" -n kargo get secret kargo-hub-kubeconfig -o jsonpath='{.data.kubeconfig\.yaml}' 2>/dev/null | base64 -d || true)
  if [ "$old" != "$kcfg" ]; then
    kubectl --context "$ctx" -n kargo create secret generic kargo-hub-kubeconfig \
      --from-literal=kubeconfig.yaml="$kcfg" --dry-run=client -o yaml | kubectl --context "$ctx" apply -f -
    # token changed: running controller still has the old one
    kubectl --context "$ctx" -n kargo get deploy kargo-controller-"$r" >/dev/null 2>&1 &&
      kubectl --context "$ctx" -n kargo rollout restart deploy/kargo-controller-"$r"
  fi

  SHARD=$r mise run infra-render kargo-shard | kubectl --context "$ctx" apply -f -
  wait_app "$ctx" kargo-ctrl
done
