#!/usr/bin/env bash
#MISE description="Render every capability into rendered/ (or out dir) and regenerate .github/CODEOWNERS"
#USAGE arg "[out]" help="output dir (default: rendered)"
# CI renders affected capabilities on ready PRs and commits them (ADR 0022); run locally to commit yourself.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
OUT="${usage_out:-rendered}"
ALL=1 platform/render/scripts/render-affected.sh . "$OUT"
