#!/usr/bin/env bash
#MISE description="Render every capability into rendered/ (or out dir) and regenerate .github/CODEOWNERS"
#USAGE arg "[out]" help="output dir (default: rendered)"
# CI runs this on every push to main and commits the result to the rendered branch (ADR 0022); locally it
# writes the gitignored rendered/ for inspection.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
OUT="${usage_out:-rendered}"
mkdir -p "$OUT"
# generated paths only
rm -rf "$OUT/apps" "$OUT/argocd" "$OUT/kargo" "$OUT/pipelines" "$OUT/codeowners" "$OUT/infrastructure"
for dir in capabilities/*/; do
  cap="$(basename "$dir")"
  platform/render/scripts/render.sh . "$cap" "$OUT" >/dev/null
  echo "rendered $cap"
done
platform/render/scripts/regions.sh "$OUT" >/dev/null  # platform-level: clusters.cue
platform/render/scripts/unique-apps.sh "$OUT"  # Application names are global per region
echo "rendered regions"
platform/render/scripts/codeowners.sh . "$OUT"
cp platform/render/rendered-README.md "$OUT/README.md"
