#!/usr/bin/env bash
#MISE description="Fresh demo cluster: tear down existing, create, install infrastructure + rendered capabilities"
set -euo pipefail

mise run down

# v4-only network: default `kind` net is dual-stack, so docker desktop forwards
# ::1 to container v6 where v4-only cluster has no NodePort -> broken https://kargo.localhost
docker network create --ipv4 --ipv6=false kargo-demo >/dev/null
KIND_EXPERIMENTAL_DOCKER_NETWORK=kargo-demo \
  kind create cluster --config platform/cluster/kind.yaml --wait 120s
kubectl --context kind-kargo-demo wait --for=condition=Ready nodes --all --timeout=120s

# regions: same network, no host ports (parallel; kind merges kubeconfig under a lock)
pids=()
for r in $(grep -v '^#' platform/cluster/regions); do
  N="region-$r" yq '.name = strenv(N)' platform/cluster/region.yaml |
    KIND_EXPERIMENTAL_DOCKER_NETWORK=kargo-demo kind create cluster --config - --wait 120s &
  pids+=($!)
done
for p in "${pids[@]}"; do wait "$p"; done
for r in $(grep -v '^#' platform/cluster/regions); do
  kubectl --context "kind-region-$r" wait --for=condition=Ready nodes --all --timeout=120s
done
kubectl config use-context kind-kargo-demo >/dev/null

mise run infra

# wait for traefik to pick up the ingressroute
for i in $(seq 1 60); do
  [ "$(curl -sk -o /dev/null -w '%{http_code}' https://kargo.localhost/)" = 200 ] && break
  [ "$i" = 60 ] && { echo "https://kargo.localhost not serving" >&2; exit 1; }
  sleep 2
done
echo "ready: https://kargo.localhost"
