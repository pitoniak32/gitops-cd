#!/usr/bin/env bash
#MISE description="Regenerate region-derived committed config from platform/render/clusters.cue (idempotent; CI checks drift)"
# Writes: platform/cluster/regions (host tasks), keycloak argocd-<r> clients, kargo api.argocd.urls
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
cfg=$(cd platform/render && cue export clusters.cue regions.cue -e regionConfig --out json)

{ echo "# one regional kind cluster per line (kind cluster = region-<name>); read by up, down, infra"
  echo "# GENERATED by mise run regions from platform/render/clusters.cue: never edit"
  jq -r '.regions[]' <<<"$cfg"; } >platform/cluster/regions

realm=platform/infrastructure/keycloak/manifests/kargo-realm.json
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
jq --argjson c "$(jq -c '.keycloakClients' <<<"$cfg")" \
  '.clients = ([.clients[] | select(.clientId | test("^argocd-") | not)] + $c)' "$realm" >"$tmp"
cat "$tmp" >"$realm"

# urls are GENERATED here (comment lives in values.yaml)
U="$(jq -c '.kargoArgocdUrls' <<<"$cfg")" yq -i '.api.argocd.urls = env(U) | (.api.argocd.urls | .. | key) style="" | (.api.argocd.urls | ..) style=""' platform/infrastructure/kargo/values.yaml
