{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EnvironmentType": {
      "description": "Platform-owned. Team targets may only point at clusters listed here,\nand only with an environment type the cluster accepts.",
      "enum": [
        "dev",
        "npr",
        "prd"
      ]
    },
    "Name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "_clusterC": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "us-east4"
            },
            {
              "const": "dc1"
            }
          ]
        }
      ]
    },
    "_gcpProjectC": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        }
      ]
    },
    "_namespaceC": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "_regionC": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "us-central1"
            },
            {
              "const": "us-east1"
            },
            {
              "const": "us-east4"
            }
          ]
        }
      ]
    }
  },
  "type": "object",
  "description": "targets/<name>/target.yml — where a stage deploys. Reusable across apps.\nSibling environment-variables/<n>.yml files: see #EnvironmentVariables, envFrom.\nplatform K8S (default): a namespace in a platform cluster, deployed by Argo CD or a gha workflow.\nplatform TERRAFORM: a GCP project + GCS state backend, applied by a gha workflow (terraform apps only).\nplatform CLOUD_RUN: a GCP project + region, a Cloud Run service deployed by a gha workflow (image apps only).",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "wifEmail": {
              "type": "string",
              "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$"
            }
          },
          "required": [
            "wifEmail"
          ],
          "propertyNames": {
            "enum": [
              "wifEmail"
            ],
            "errorMessage": "Unknown key. Allowed: wifEmail"
          }
        },
        "backend": {
          "type": "object",
          "properties": {
            "bucket": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
                }
              ]
            },
            "prefix": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._/-]+$"
                }
              ]
            }
          },
          "required": [
            "bucket"
          ],
          "propertyNames": {
            "enum": [
              "bucket",
              "prefix"
            ],
            "errorMessage": "Unknown key. Allowed: bucket, prefix"
          }
        },
        "billing": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "cluster": {
          "description": "Which fields are required or forbidden is per platform. cluster, namespace: K8S only. region\n(the GCP region; a K8S target's is its cluster's), gcpProject: TERRAFORM and CLOUD_RUN.\nbackend (GCS state; prefix default <capability>/<app>/<target>): TERRAFORM only.",
          "$ref": "#/$defs/_clusterC"
        },
        "environment": {
          "description": "free name (namespaces, labels); the type drives policy",
          "$ref": "#/$defs/Name"
        },
        "environmentType": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentType"
            }
          ]
        },
        "gcpProject": {
          "$ref": "#/$defs/_gcpProjectC"
        },
        "namespace": {
          "$ref": "#/$defs/_namespaceC"
        },
        "platform": {
          "anyOf": [
            {
              "const": "K8S"
            },
            {
              "const": "TERRAFORM"
            },
            {
              "const": "CLOUD_RUN"
            }
          ]
        },
        "region": {
          "$ref": "#/$defs/_regionC"
        }
      },
      "required": [
        "auth",
        "billing",
        "environment",
        "environmentType"
      ],
      "propertyNames": {
        "enum": [
          "auth",
          "backend",
          "billing",
          "cluster",
          "environment",
          "environmentType",
          "gcpProject",
          "namespace",
          "platform",
          "region"
        ],
        "errorMessage": "Unknown key. Allowed: auth, backend, billing, cluster, environment, environmentType, gcpProject, namespace, platform, region"
      }
    }
  },
  "required": [
    "config"
  ],
  "propertyNames": {
    "enum": [
      "config"
    ],
    "errorMessage": "Unknown key. Allowed: config"
  }
}
