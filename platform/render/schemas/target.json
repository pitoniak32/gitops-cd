{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EnvironmentType": {
      "description": "Platform-owned. Team targets may only point at clusters listed here,\nand only with an environment type the cluster accepts.",
      "enum": [
        "dev",
        "npr",
        "prd"
      ]
    },
    "Name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    }
  },
  "type": "object",
  "description": "targets/<name>/target.yml — where a stage deploys. Reusable across apps.\nSibling environment-variables/<n>.yml files: see #EnvironmentVariables, envFrom.\nplatform K8S (default): a namespace in a platform cluster, deployed by Argo CD or a gha workflow.\nplatform TERRAFORM: a GCP project + GCS state backend, applied by a gha workflow (terraform apps only).",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "wifEmail": {
              "type": "string",
              "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$"
            }
          },
          "required": [
            "wifEmail"
          ],
          "propertyNames": {
            "enum": [
              "wifEmail"
            ],
            "errorMessage": "Unknown key. Allowed: wifEmail"
          }
        },
        "billing": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "cluster": {
          "description": "Constraints for both platforms here (the editor schema is exported generic, so it allows either);\nwhich fields are required or forbidden is per platform below.",
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "us-east4"
                },
                {
                  "const": "dc1"
                }
              ]
            }
          ]
        },
        "environment": {
          "description": "free name (namespaces, labels); the type drives policy",
          "$ref": "#/$defs/Name"
        },
        "environmentType": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentType"
            }
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "platform": {
          "anyOf": [
            {
              "const": "K8S"
            },
            {
              "const": "TERRAFORM"
            }
          ]
        },
        "region": {
          "description": "TERRAFORM only: the GCP region (a K8S target's is its cluster's)",
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "us-central1"
                },
                {
                  "const": "us-east1"
                },
                {
                  "const": "us-east4"
                }
              ]
            }
          ]
        },
        "terraform": {
          "type": "object",
          "properties": {
            "backend": {
              "type": "object",
              "description": "GCS state; prefix default <capability>/<app>/<target>",
              "properties": {
                "bucket": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
                    }
                  ]
                },
                "prefix": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._/-]+$"
                    }
                  ]
                }
              },
              "required": [
                "bucket"
              ],
              "propertyNames": {
                "enum": [
                  "bucket",
                  "prefix"
                ],
                "errorMessage": "Unknown key. Allowed: bucket, prefix"
              }
            },
            "gcpProject": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
                }
              ]
            }
          },
          "required": [
            "backend",
            "gcpProject"
          ],
          "propertyNames": {
            "enum": [
              "backend",
              "gcpProject"
            ],
            "errorMessage": "Unknown key. Allowed: backend, gcpProject"
          }
        }
      },
      "required": [
        "auth",
        "billing",
        "environment",
        "environmentType"
      ],
      "propertyNames": {
        "enum": [
          "auth",
          "billing",
          "cluster",
          "environment",
          "environmentType",
          "namespace",
          "platform",
          "region",
          "terraform"
        ],
        "errorMessage": "Unknown key. Allowed: auth, billing, cluster, environment, environmentType, namespace, platform, region, terraform"
      }
    }
  },
  "required": [
    "config"
  ],
  "propertyNames": {
    "enum": [
      "config"
    ],
    "errorMessage": "Unknown key. Allowed: config"
  }
}
