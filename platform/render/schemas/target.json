{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Environment": {
      "description": "Platform-owned. Team targets may only point at clusters listed here,\nand only with an environment the cluster accepts.",
      "enum": [
        "dev",
        "staging",
        "perf",
        "prod"
      ]
    }
  },
  "type": "object",
  "description": "targets/<name>/target.yml — where a stage deploys. Reusable across apps.\nSibling environment-variables/<n>.yml files: see #EnvironmentVariables, envFrom.\nplatform K8S (default): a namespace in a platform cluster, deployed by Argo CD or a gha workflow.\nplatform TERRAFORM: a GCP project + GCS state backend, applied by a gha workflow (terraform apps only).",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "wifEmail": {
              "type": "string",
              "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$"
            }
          },
          "required": [
            "wifEmail"
          ],
          "propertyNames": {
            "enum": [
              "wifEmail"
            ],
            "errorMessage": "Unknown key. Allowed: wifEmail"
          }
        },
        "billing": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "cluster": {
          "type": "string",
          "description": "set per platform below; declared here so a misplaced field gets the message, not \"field not allowed\"",
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "us"
                },
                {
                  "const": "onprem"
                }
              ]
            }
          ]
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "platform": {
          "anyOf": [
            {
              "const": "K8S"
            },
            {
              "const": "TERRAFORM"
            }
          ]
        },
        "terraform": false
      },
      "required": [
        "auth",
        "billing",
        "cluster",
        "environment",
        "namespace"
      ],
      "propertyNames": {
        "enum": [
          "auth",
          "billing",
          "cluster",
          "environment",
          "namespace",
          "platform",
          "terraform"
        ],
        "errorMessage": "Unknown key. Allowed: auth, billing, cluster, environment, namespace, platform, terraform"
      }
    }
  },
  "required": [
    "config"
  ],
  "propertyNames": {
    "enum": [
      "config"
    ],
    "errorMessage": "Unknown key. Allowed: config"
  }
}
