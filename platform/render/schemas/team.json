{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "teams/<team>.yml: a GitHub team, used only for CODEOWNERS (code review).\nUI access is by email (owners.yml), never by IdP groups (ADR 0011).",
  "properties": {
    "githubTeam": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
        }
      ]
    }
  },
  "required": [
    "githubTeam"
  ],
  "propertyNames": {
    "enum": [
      "githubTeam"
    ],
    "errorMessage": "Unknown key. Allowed: githubTeam"
  }
}
