{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "stages/<name>.yml",
  "properties": {
    "autoPromote": {
      "type": "boolean",
      "description": "promote automatically once upstream stages are verified"
    },
    "color": {
      "description": "Kargo UI color for all of this stage's Kargo Stages (control flow + targets); default picked per stage",
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "red"
            },
            {
              "const": "salmon"
            },
            {
              "const": "orange"
            },
            {
              "const": "amber"
            },
            {
              "const": "yellow"
            },
            {
              "const": "lime"
            },
            {
              "const": "avocado"
            },
            {
              "const": "green"
            },
            {
              "const": "teal"
            },
            {
              "const": "cyan"
            },
            {
              "const": "sky"
            },
            {
              "const": "blue"
            },
            {
              "const": "indigo"
            },
            {
              "const": "periwinkle"
            },
            {
              "const": "violet"
            },
            {
              "const": "purple"
            },
            {
              "const": "fuchsia"
            },
            {
              "const": "pink"
            },
            {
              "const": "rose"
            },
            {
              "const": "dragonfruit"
            },
            {
              "const": "gray"
            }
          ]
        }
      ]
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "propertyNames": {
    "enum": [
      "autoPromote",
      "color",
      "dependsOn"
    ],
    "errorMessage": "Unknown key. Allowed: autoPromote, color, dependsOn"
  }
}
