{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EnvValue": {
      "type": "string",
      "description": "Plain value, or a Secret Manager ref: secret:<gcp-project>/<secret>[@<version>]",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?![\\s\\S]*?(?:^secret:))",
          "patternErrorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]"
        },
        {
          "type": "string",
          "pattern": "^secret:[a-z][a-z0-9-]{4,28}[a-z0-9]/[A-Za-z0-9_-]+(@([0-9]+|latest))?$",
          "patternErrorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]"
        }
      ],
      "errorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]",
      "patternErrorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]"
    },
    "EnvironmentVariables": {
      "type": "object",
      "description": "targets/<t>/environment-variables/<name>.yml: flat KEY: value map",
      "patternProperties": {
        "^[A-Z_][A-Z0-9_]*$": {
          "$ref": "#/$defs/EnvValue"
        }
      },
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$",
        "errorMessage": "Invalid name, must match ^[A-Z_][A-Z0-9_]*$",
        "patternErrorMessage": "Invalid name, must match ^[A-Z_][A-Z0-9_]*$"
      }
    },
    "Layer": {
      "type": "object",
      "description": "Settings that can be set at app, stage, or target level. Most specific wins;\nenv is merged per key.",
      "properties": {
        "deployWith": {
          "description": "How promotion deploys a target: argocd (default) syncs its Argo CD app; gha dispatches\n`workflow` with the promoted commit and image and waits for the run (ADR 0020).",
          "anyOf": [
            {
              "const": "argocd"
            },
            {
              "const": "gha"
            }
          ]
        },
        "env": {
          "$ref": "#/$defs/EnvironmentVariables"
        },
        "envFrom": {
          "type": "array",
          "description": "targets/<t>/environment-variables/<name>.yml of each deployed target; every listed\nname must exist for every target it reaches. A KEY from a more specific layer's\nenvFrom wins; any env wins over all of them.",
          "items": {
            "$ref": "#/$defs/Name"
          }
        },
        "replicas": {
          "allOf": [
            {
              "type": "number"
            },
            {
              "type": "integer",
              "maximum": 100,
              "minimum": 0
            }
          ]
        },
        "resources": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m?$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$"
            }
          },
          "propertyNames": {
            "enum": [
              "cpu",
              "memory"
            ],
            "errorMessage": "Unknown key. Allowed: cpu, memory"
          }
        },
        "workflow": {
          "type": "object",
          "description": "GitHub Actions workflow for gha targets (ignored where deployWith is argocd); each field\ndefaults separately: repo this repo, file deploy.yaml, ref main.",
          "properties": {
            "file": {
              "description": "file name under <repo>/.github/workflows/",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$"
                }
              ]
            },
            "ref": {
              "type": "string",
              "not": {
                "const": ""
              }
            },
            "repo": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                }
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "file",
              "ref",
              "repo"
            ],
            "errorMessage": "Unknown key. Allowed: file, ref, repo"
          }
        }
      },
      "propertyNames": {
        "enum": [
          "deployWith",
          "env",
          "envFrom",
          "replicas",
          "resources",
          "workflow"
        ],
        "errorMessage": "Unknown key. Allowed: deployWith, env, envFrom, replicas, resources, workflow"
      }
    },
    "Name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "StageLayer": {
      "type": "object",
      "properties": {
        "deployWith": {
          "description": "How promotion deploys a target: argocd (default) syncs its Argo CD app; gha dispatches\n`workflow` with the promoted commit and image and waits for the run (ADR 0020).",
          "anyOf": [
            {
              "const": "argocd"
            },
            {
              "const": "gha"
            }
          ]
        },
        "env": {
          "$ref": "#/$defs/EnvironmentVariables"
        },
        "envFrom": {
          "type": "array",
          "description": "targets/<t>/environment-variables/<name>.yml of each deployed target; every listed\nname must exist for every target it reaches. A KEY from a more specific layer's\nenvFrom wins; any env wins over all of them.",
          "items": {
            "$ref": "#/$defs/Name"
          }
        },
        "replicas": {
          "allOf": [
            {
              "type": "number"
            },
            {
              "type": "integer",
              "maximum": 100,
              "minimum": 0
            }
          ]
        },
        "resources": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m?$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$"
            }
          },
          "propertyNames": {
            "enum": [
              "cpu",
              "memory"
            ],
            "errorMessage": "Unknown key. Allowed: cpu, memory"
          }
        },
        "workflow": {
          "type": "object",
          "description": "GitHub Actions workflow for gha targets (ignored where deployWith is argocd); each field\ndefaults separately: repo this repo, file deploy.yaml, ref main.",
          "properties": {
            "file": {
              "description": "file name under <repo>/.github/workflows/",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$"
                }
              ]
            },
            "ref": {
              "type": "string",
              "not": {
                "const": ""
              }
            },
            "repo": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                }
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "file",
              "ref",
              "repo"
            ],
            "errorMessage": "Unknown key. Allowed: file, ref, repo"
          }
        },
        "targets": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,39}$": {
              "$ref": "#/$defs/Layer"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "errorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$",
            "patternErrorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$"
          }
        }
      },
      "propertyNames": {
        "enum": [
          "deployWith",
          "env",
          "envFrom",
          "replicas",
          "resources",
          "targets",
          "workflow"
        ],
        "errorMessage": "Unknown key. Allowed: deployWith, env, envFrom, replicas, resources, targets, workflow"
      }
    }
  },
  "type": "object",
  "description": "apps/<name>/app.yml",
  "properties": {
    "deployWith": {
      "description": "How promotion deploys a target: argocd (default) syncs its Argo CD app; gha dispatches\n`workflow` with the promoted commit and image and waits for the run (ADR 0020).",
      "anyOf": [
        {
          "const": "argocd"
        },
        {
          "const": "gha"
        }
      ]
    },
    "env": {
      "$ref": "#/$defs/EnvironmentVariables"
    },
    "envFrom": {
      "type": "array",
      "description": "targets/<t>/environment-variables/<name>.yml of each deployed target; every listed\nname must exist for every target it reaches. A KEY from a more specific layer's\nenvFrom wins; any env wins over all of them.",
      "items": {
        "$ref": "#/$defs/Name"
      }
    },
    "replicas": {
      "allOf": [
        {
          "type": "number"
        },
        {
          "type": "integer",
          "maximum": 100,
          "minimum": 0
        }
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[0-9]+m?$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      },
      "propertyNames": {
        "enum": [
          "cpu",
          "memory"
        ],
        "errorMessage": "Unknown key. Allowed: cpu, memory"
      }
    },
    "workflow": {
      "type": "object",
      "description": "GitHub Actions workflow for gha targets (ignored where deployWith is argocd); each field\ndefaults separately: repo this repo, file deploy.yaml, ref main.",
      "properties": {
        "file": {
          "description": "file name under <repo>/.github/workflows/",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$"
            }
          ]
        },
        "ref": {
          "type": "string",
          "not": {
            "const": ""
          }
        },
        "repo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          ]
        }
      },
      "propertyNames": {
        "enum": [
          "file",
          "ref",
          "repo"
        ],
        "errorMessage": "Unknown key. Allowed: file, ref, repo"
      }
    },
    "image": {
      "type": "string",
      "description": "Image repository, no tag or digest: the app's Warehouse discovers SemVer tags, Freight pins one\n(by digest) next to the config commit, and promotion writes it into the target (ADR 0016).",
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$",
      "errorMessage": "Image repository only, no tag or digest (Kargo discovers SemVer tags)",
      "patternErrorMessage": "Image repository only, no tag or digest (Kargo discovers SemVer tags)"
    },
    "imageConstraint": {
      "type": "string",
      "description": "SemVer range for discovered tags (e.g. ^1, ~1.2); unset: any SemVer tag.",
      "not": {
        "const": ""
      }
    },
    "port": {
      "allOf": [
        {
          "type": "number"
        },
        {
          "type": "integer",
          "exclusiveMaximum": 65536,
          "exclusiveMinimum": 0
        }
      ]
    },
    "stages": {
      "type": "object",
      "description": "Subset of the capability's stages. Skipped stages are bypassed in the pipeline\n(prod depends on [staging, perf]; without perf, prod depends on staging).",
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,39}$": {
          "$ref": "#/$defs/StageLayer"
        }
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,39}$",
        "errorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$",
        "patternErrorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$"
      }
    }
  },
  "required": [
    "image"
  ],
  "propertyNames": {
    "enum": [
      "deployWith",
      "env",
      "envFrom",
      "image",
      "imageConstraint",
      "port",
      "replicas",
      "resources",
      "stages",
      "workflow"
    ],
    "errorMessage": "Unknown key. Allowed: deployWith, env, envFrom, image, imageConstraint, port, replicas, resources, stages, workflow"
  }
}
