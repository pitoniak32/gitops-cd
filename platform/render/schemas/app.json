{
  "$defs": {
    "EnvValue": {
      "anyOf": [
        {
          "pattern": "^(?![\\s\\S]*?(?:^secret:))",
          "patternErrorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]",
          "type": "string"
        },
        {
          "pattern": "^secret:[a-z][a-z0-9-]{4,28}[a-z0-9]/[A-Za-z0-9_-]+(@([0-9]+|latest))?$",
          "patternErrorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]",
          "type": "string"
        }
      ],
      "description": "Plain value, or a Secret Manager ref: secret:<gcp-project>/<secret>[@<version>]",
      "errorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]",
      "patternErrorMessage": "Plain string, or secret:<gcp-project>/<secret>[@<version>]",
      "type": "string"
    },
    "EnvironmentVariables": {
      "description": "targets/<t>/environment-variables/<name>.yml: flat KEY: value map",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/EnvValue"
        }
      },
      "propertyNames": {
        "errorMessage": "Invalid name, must match ^[A-Za-z_][A-Za-z0-9_]*$",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "patternErrorMessage": "Invalid name, must match ^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "type": "object"
    },
    "Layer": {
      "description": "Settings that can be set at app, stage, or target level. Most specific wins;\nenv is merged per key.",
      "properties": {
        "deployWith": {
          "anyOf": [
            {
              "const": "argocd"
            },
            {
              "const": "gha"
            }
          ],
          "description": "How promotion deploys a target: argocd (default) syncs its Argo CD app; gha dispatches\n`workflow` with the promoted commit and image and waits for the run (ADR 0020)."
        },
        "env": {
          "$ref": "#/$defs/EnvironmentVariables"
        },
        "envFrom": {
          "description": "targets/<t>/environment-variables/<name>.yml of each deployed target; every listed\nname must exist for every target it reaches. A KEY from a more specific layer's\nenvFrom wins; any env wins over all of them.",
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        },
        "replicas": {
          "allOf": [
            {
              "type": "number"
            },
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            }
          ]
        },
        "resources": {
          "properties": {
            "cpu": {
              "pattern": "^[0-9]+m?$",
              "type": "string"
            },
            "memory": {
              "pattern": "^[0-9]+(Mi|Gi)$",
              "type": "string"
            }
          },
          "propertyNames": {
            "enum": [
              "cpu",
              "memory"
            ],
            "errorMessage": "Unknown key. Allowed: cpu, memory"
          },
          "type": "object"
        },
        "workflow": {
          "description": "GitHub Actions workflow for gha targets (ignored where deployWith is argocd); each field\ndefaults separately: repo this repo, file deploy.yaml, ref main.",
          "properties": {
            "file": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$",
                  "type": "string"
                }
              ],
              "description": "file name under <repo>/.github/workflows/"
            },
            "ref": {
              "anyOf": [
                {
                  "not": {
                    "const": ""
                  },
                  "type": "string"
                }
              ]
            },
            "repo": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "type": "string"
                }
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "file",
              "ref",
              "repo"
            ],
            "errorMessage": "Unknown key. Allowed: file, ref, repo"
          },
          "type": "object"
        }
      },
      "propertyNames": {
        "enum": [
          "deployWith",
          "env",
          "envFrom",
          "replicas",
          "resources",
          "workflow"
        ],
        "errorMessage": "Unknown key. Allowed: deployWith, env, envFrom, replicas, resources, workflow"
      },
      "type": "object"
    },
    "Name": {
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "type": "string"
    },
    "StageLayer": {
      "properties": {
        "deployWith": {
          "anyOf": [
            {
              "const": "argocd"
            },
            {
              "const": "gha"
            }
          ],
          "description": "How promotion deploys a target: argocd (default) syncs its Argo CD app; gha dispatches\n`workflow` with the promoted commit and image and waits for the run (ADR 0020)."
        },
        "env": {
          "$ref": "#/$defs/EnvironmentVariables"
        },
        "envFrom": {
          "description": "targets/<t>/environment-variables/<name>.yml of each deployed target; every listed\nname must exist for every target it reaches. A KEY from a more specific layer's\nenvFrom wins; any env wins over all of them.",
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        },
        "replicas": {
          "allOf": [
            {
              "type": "number"
            },
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            }
          ]
        },
        "resources": {
          "properties": {
            "cpu": {
              "pattern": "^[0-9]+m?$",
              "type": "string"
            },
            "memory": {
              "pattern": "^[0-9]+(Mi|Gi)$",
              "type": "string"
            }
          },
          "propertyNames": {
            "enum": [
              "cpu",
              "memory"
            ],
            "errorMessage": "Unknown key. Allowed: cpu, memory"
          },
          "type": "object"
        },
        "targets": {
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,39}$": {
              "$ref": "#/$defs/Layer"
            }
          },
          "propertyNames": {
            "errorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$",
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "patternErrorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$"
          },
          "type": "object"
        },
        "workflow": {
          "description": "GitHub Actions workflow for gha targets (ignored where deployWith is argocd); each field\ndefaults separately: repo this repo, file deploy.yaml, ref main.",
          "properties": {
            "file": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$",
                  "type": "string"
                }
              ],
              "description": "file name under <repo>/.github/workflows/"
            },
            "ref": {
              "anyOf": [
                {
                  "not": {
                    "const": ""
                  },
                  "type": "string"
                }
              ]
            },
            "repo": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "type": "string"
                }
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "file",
              "ref",
              "repo"
            ],
            "errorMessage": "Unknown key. Allowed: file, ref, repo"
          },
          "type": "object"
        }
      },
      "propertyNames": {
        "enum": [
          "deployWith",
          "env",
          "envFrom",
          "replicas",
          "resources",
          "targets",
          "workflow"
        ],
        "errorMessage": "Unknown key. Allowed: deployWith, env, envFrom, replicas, resources, targets, workflow"
      },
      "type": "object"
    },
    "_ociRepo": {
      "errorMessage": "Image repository only, no tag or digest (Kargo discovers SemVer tags)",
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$",
      "patternErrorMessage": "Image repository only, no tag or digest (Kargo discovers SemVer tags)",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "apps/<name>/app.yml",
  "properties": {
    "deployWith": {
      "anyOf": [
        {
          "const": "argocd"
        },
        {
          "const": "gha"
        }
      ],
      "description": "How promotion deploys a target: argocd (default) syncs its Argo CD app; gha dispatches\n`workflow` with the promoted commit and image and waits for the run (ADR 0020)."
    },
    "env": {
      "$ref": "#/$defs/EnvironmentVariables"
    },
    "envFrom": {
      "description": "targets/<t>/environment-variables/<name>.yml of each deployed target; every listed\nname must exist for every target it reaches. A KEY from a more specific layer's\nenvFrom wins; any env wins over all of them.",
      "items": {
        "$ref": "#/$defs/Name"
      },
      "type": "array"
    },
    "image": {
      "$ref": "#/$defs/_ociRepo",
      "description": "Exactly one of image (K8s app) or module (terraform app, ADR 0021).\nImage repository, no tag or digest: the app's Warehouse discovers SemVer tags, Freight pins one\n(by digest) next to the config commit, and promotion writes it into the target (ADR 0016)."
    },
    "imageConstraint": {
      "description": "SemVer range for discovered tags (e.g. ^1, ~1.2); unset: any SemVer tag.",
      "not": {
        "const": ""
      },
      "type": "string"
    },
    "module": {
      "$ref": "#/$defs/_ociRepo",
      "description": "Terraform module as an OCI artifact repository (oras push, single manifest), no tag or digest;\ndiscovered and pinned like image. Its targets must be TERRAFORM targets."
    },
    "moduleConstraint": {
      "description": "SemVer range for discovered module tags; unset: any SemVer tag.",
      "not": {
        "const": ""
      },
      "type": "string"
    },
    "port": {
      "allOf": [
        {
          "type": "number"
        },
        {
          "exclusiveMaximum": 65536,
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      ]
    },
    "replicas": {
      "allOf": [
        {
          "type": "number"
        },
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "resources": {
      "properties": {
        "cpu": {
          "pattern": "^[0-9]+m?$",
          "type": "string"
        },
        "memory": {
          "pattern": "^[0-9]+(Mi|Gi)$",
          "type": "string"
        }
      },
      "propertyNames": {
        "enum": [
          "cpu",
          "memory"
        ],
        "errorMessage": "Unknown key. Allowed: cpu, memory"
      },
      "type": "object"
    },
    "sourceRepo": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        }
      ],
      "description": "GitHub repo of the app's code; platform pre-deploy checks are dispatched there (ADR 0028)"
    },
    "stages": {
      "description": "Subset of the capability's stages. Skipped stages are bypassed in the pipeline\n(prod depends on [staging, perf]; without perf, prod depends on staging).",
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,39}$": {
          "$ref": "#/$defs/StageLayer"
        }
      },
      "propertyNames": {
        "errorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$",
        "pattern": "^[a-z][a-z0-9-]{0,39}$",
        "patternErrorMessage": "Invalid name, must match ^[a-z][a-z0-9-]{0,39}$"
      },
      "type": "object"
    },
    "workflow": {
      "description": "GitHub Actions workflow for gha targets (ignored where deployWith is argocd); each field\ndefaults separately: repo this repo, file deploy.yaml, ref main.",
      "properties": {
        "file": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$",
              "type": "string"
            }
          ],
          "description": "file name under <repo>/.github/workflows/"
        },
        "ref": {
          "anyOf": [
            {
              "not": {
                "const": ""
              },
              "type": "string"
            }
          ]
        },
        "repo": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
              "type": "string"
            }
          ]
        }
      },
      "propertyNames": {
        "enum": [
          "file",
          "ref",
          "repo"
        ],
        "errorMessage": "Unknown key. Allowed: file, ref, repo"
      },
      "type": "object"
    }
  },
  "propertyNames": {
    "enum": [
      "deployWith",
      "env",
      "envFrom",
      "image",
      "imageConstraint",
      "module",
      "moduleConstraint",
      "port",
      "replicas",
      "resources",
      "sourceRepo",
      "stages",
      "workflow"
    ],
    "errorMessage": "Unknown key. Allowed: deployWith, env, envFrom, image, imageConstraint, module, moduleConstraint, port, replicas, resources, sourceRepo, stages, workflow"
  },
  "required": [
    "sourceRepo"
  ],
  "type": "object"
}
