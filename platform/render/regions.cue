package render

import (
	"encoding/json"
	"list"
)

// Platform-level outputs derived from clusters.cue only (no capability input; evaluate with
// `cue export clusters.cue regions.cue`, the full package needs a capability).
_regions: list.SortStrings([for r, _ in {for _, c in clusters {(c.region): _}} {r}])

// rendered/ paths (gcd render): region list for hub-side AppSets (git files generator) and an
// AppProjects dir per region so each region's argocd-projects app has a path even without targets
regionFiles: {
	for r in _regions {
		"infrastructure/regions/\(r).json": json.Marshal({region: r}) + "\n"
		"argocd/projects/\(r)/.keep": ""
	}
}

// committed config generated by `mise run regions` (CI checks drift)
regionConfig: {
	regions: _regions
	keycloakClients: [for r in _regions {
		clientId:                  "argocd-\(r)"
		name:                      "Argo CD (\(r))"
		publicClient:              true
		standardFlowEnabled:       true
		directAccessGrantsEnabled: false
		redirectUris: ["https://argocd-\(r).localhost/pkce/verify", "https://argocd-\(r).localhost/auth/callback", "http://localhost:8085/auth/callback"]
		webOrigins: ["https://argocd-\(r).localhost"]
		attributes: {
			"pkce.code.challenge.method": "S256"
			"post.logout.redirect.uris":  "https://argocd-\(r).localhost/*"
		}
	}]
	kargoArgocdUrls: {for r in _regions {(r): "https://argocd-\(r).localhost"}}
}
