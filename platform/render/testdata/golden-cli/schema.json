  {
    "kind": "target",
    "file": "systems/{sys}/targets/*/target.yml",
    "desc": "a target: where a stage deploys, reusable across apps",
    "fields": [
      {
        "name": "config",
        "type": "map",
        "required": true,
        "desc": "where a stage deploys; reusable across apps",
        "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:1",
        "fields": [
          {
            "name": "platform",
            "type": "str",
            "enum": [
              "K8S",
              "CLOUD_RUN",
              "TERRAFORM"
            ],
            "desc": "K8S (default), TERRAFORM or CLOUD_RUN",
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:9"
          },
          {
            "name": "environment",
            "type": "str",
            "required": true,
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "desc": "environment name, free-form (namespaces, labels)",
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:4"
          },
          {
            "name": "environmentType",
            "type": "str",
            "required": true,
            "enum": [
              "dev",
              "npr",
              "prd"
            ],
            "desc": "dev, npr or prd; drives policy (replicas, pre-deploy checks, cluster choice)",
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:5"
          },
          {
            "name": "auth",
            "type": "map",
            "required": true,
            "desc": "workload identity used to deploy",
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:6",
            "fields": [
              {
                "name": "wifEmail",
                "type": "str",
                "required": true,
                "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$",
                "desc": "service account email of the workload identity",
                "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:7"
              }
            ]
          },
          {
            "name": "billing",
            "type": "str",
            "required": true,
            "pattern": "^[a-z0-9-]+$",
            "desc": "billing label for the target's cost",
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:8"
          },
          {
            "name": "cluster",
            "type": "str",
            "enum": [
              "us-east4",
              "dc1"
            ],
            "desc": "name of the platform's cluster to deploy to; must accept the environment type",
            "platforms": [
              "K8S"
            ],
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:2"
          },
          {
            "name": "namespace",
            "type": "str",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "desc": "Kubernetes namespace",
            "platforms": [
              "K8S"
            ],
            "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/target.yml:3"
          },
          {
            "name": "region",
            "type": "str",
            "enum": [
              "us-central1",
              "us-east1",
              "us-east4"
            ],
            "desc": "GCP region",
            "platforms": [
              "CLOUD_RUN",
              "TERRAFORM"
            ],
            "example": "platform/render/testdata/root/systems/payments/targets/us-east4-dev-tf/target.yml:4"
          },
          {
            "name": "gcpProject",
            "type": "str",
            "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
            "desc": "GCP project id",
            "platforms": [
              "CLOUD_RUN",
              "TERRAFORM"
            ],
            "example": "platform/render/testdata/root/systems/payments/targets/us-east4-dev-tf/target.yml:10"
          },
          {
            "name": "backend",
            "type": "map",
            "desc": "terraform state backend",
            "platforms": [
              "TERRAFORM"
            ],
            "example": "platform/render/testdata/root/systems/payments/targets/us-east4-dev-tf/target.yml:11",
            "fields": [
              {
                "name": "bucket",
                "type": "str",
                "required": true,
                "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$",
                "desc": "GCS bucket holding terraform state",
                "example": "platform/render/testdata/root/systems/payments/targets/us-east4-dev-tf/target.yml:12"
              },
              {
                "name": "prefix",
                "type": "str",
                "pattern": "^[A-Za-z0-9._/-]+$",
                "desc": "GCS object prefix for the state",
                "example": "platform/render/testdata/root/systems/payments/targets/us-east4-prd-tf/target.yml:12"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "kind": "env-vars",
    "file": "systems/{sys}/targets/*/environment-variables/*.yml",
    "desc": "environment variables shared by apps that opt in with envFrom",
    "fields": [
      {
        "name": "*",
        "type": "str",
        "desc": "value of the variable named by the key",
        "example": "platform/render/testdata/root/systems/payments/targets/dc1-dev-k8s/environment-variables/launchdarkly.yml:1"
      }
    ]
  }
]
