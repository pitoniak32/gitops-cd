                  "type": "str",
                  "pattern": "^[0-9]+m?$",
                  "desc": "CPU, whole cores or millicores (100m)",
                  "example": "platform/render/testdata/root/systems/payments/apps/my-app/app.yml:40"
                },
                {
                  "name": "memory",
                  "type": "str",
                  "pattern": "^[0-9]+(Mi|Gi)$",
                  "desc": "memory in Mi or Gi (128Mi)",
                  "example": "platform/render/testdata/root/systems/payments/apps/my-app/app.yml:41"
                }
              ]
            },
            {
              "name": "deployWith",
