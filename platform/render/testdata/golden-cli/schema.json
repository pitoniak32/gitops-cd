            {
              "name": "autoPromote",
              "type": "bool",
              "desc": "this app only: overrides the stage's autoPromote (default false: promoted by a person)",
              "example": "platform/render/testdata/root/systems/payments/apps/worker/app.yml:6"
            },
            {
              "name": "targets",
              "type": "dict",
              "desc": "targets this stage deploys to, by target name; settings here override the stage's and app's",
