              "example": "platform/render/testdata/root/systems/payments/apps/my-app/app.yml:12",
              "elem": {
                "type": "str",
                "example": "platform/render/testdata/root/systems/payments/apps/my-app/app.yml:13"
              }
            },
            {
              "name": "envFrom",
