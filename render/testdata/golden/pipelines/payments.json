            "cluster": "onprem-p1",
            "namespace": "team1",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/on-prem-prod-1"
          },
          "on-prem-prod-2": {
            "cluster": "onprem-p2",
            "namespace": "team1",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/on-prem-prod-2"
