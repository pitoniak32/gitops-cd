{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "teams/<team>.yml: who a team is. Platform-owned (CODEOWNERS).",
  "properties": {
    "githubTeam": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
        }
      ]
    },
    "idpGroup": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      ]
    }
  },
  "required": [
    "githubTeam",
    "idpGroup"
  ],
  "propertyNames": {
    "enum": [
      "githubTeam",
      "idpGroup"
    ],
    "errorMessage": "Unknown key. Allowed: githubTeam, idpGroup"
  }
}
