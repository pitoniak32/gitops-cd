{
  "realm": "kargo",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "kargo",
      "name": "Kargo",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://kargo.localhost/login",
        "http://localhost*"
      ],
      "webOrigins": [
        "https://kargo.localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://kargo.localhost/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "argocd",
      "name": "Argo CD",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://argocd.localhost/pkce/verify",
        "https://argocd.localhost/auth/callback",
        "http://localhost:8085/auth/callback"
      ],
      "webOrigins": [
        "https://argocd.localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://argocd.localhost/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "doug",
      "email": "doug@example.com",
      "firstName": "Doug",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "doug",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-kargo"
      ],
      "groups": [
        "/team1"
      ]
    },
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Viewer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-kargo"
      ],
      "groups": [
        "/team2"
      ]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Viewer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-kargo"
      ]
    }
  ],
  "groups": [
    {
      "name": "team1"
