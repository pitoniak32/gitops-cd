#!/usr/bin/env bash
#MISE description="Fresh demo cluster: tear down existing, create, install platform + project"
set -euo pipefail

mise run down

# v4-only network: default `kind` net is dual-stack, so docker desktop forwards
# ::1 to container v6 where v4-only cluster has no NodePort -> broken https://kargo.localhost
docker network create --ipv4 --ipv6=false kargo-demo >/dev/null
KIND_EXPERIMENTAL_DOCKER_NETWORK=kargo-demo \
  kind create cluster --config cluster/kind.yaml --wait 120s
kubectl wait --for=condition=Ready nodes --all --timeout=120s

mise run platform
mise run project

# wait for traefik to pick up the ingressroute
for i in $(seq 1 60); do
  [ "$(curl -sk -o /dev/null -w '%{http_code}' https://kargo.localhost/)" = 200 ] && break
  [ "$i" = 60 ] && { echo "https://kargo.localhost not serving" >&2; exit 1; }
  sleep 2
done
echo "ready: https://kargo.localhost"
