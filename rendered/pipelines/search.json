{
  "api": {
    "capability": "search",
    "app": "api",
    "stages": {
      "dev": {
        "dependsOn": [],
        "autoPromote": true,
        "level": 0,
        "targets": {
          "us-east4-dev-k8s": {
            "cluster": "us-east4",
            "namespace": "search-us-dev",
            "platform": "K8S",
            "environment": "dev",
            "environmentType": "dev",
            "path": "apps/search/api/dev/us-east4-dev-k8s",
            "deployWith": "argocd"
          }
        }
      },
      "prod": {
        "dependsOn": [
          "dev"
        ],
        "autoPromote": false,
        "level": 1,
        "targets": {
          "us-east4-prd-k8s": {
            "cluster": "us-east4",
            "namespace": "search-us-prod",
            "platform": "K8S",
            "environment": "prod",
            "environmentType": "prd",
            "path": "apps/search/api/prod/us-east4-prd-k8s",
            "deployWith": "argocd"
          },
          "dc1-prd-k8s": {
            "cluster": "dc1",
            "namespace": "search-onprem-prod",
            "platform": "K8S",
            "environment": "prod",
            "environmentType": "prd",
            "path": "apps/search/api/prod/dc1-prd-k8s",
            "deployWith": "argocd"
          }
        }
      }
    },
    "levels": [
      [
        "dev"
      ],
      [
        "prod"
      ]
    ]
  }
}
