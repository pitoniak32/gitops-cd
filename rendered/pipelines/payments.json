{
  "my-app": {
    "capability": "payments",
    "app": "my-app",
    "stages": {
      "dev": {
        "dependsOn": [],
        "autoPromote": true,
        "level": 0,
        "targets": {
          "us-dev": {
            "cluster": "us",
            "namespace": "payments-us-dev",
            "environment": "dev",
            "path": "apps/payments/my-app/dev/us-dev"
          },
          "onprem-dev": {
            "cluster": "onprem",
            "namespace": "payments-onprem-dev",
            "environment": "dev",
            "path": "apps/payments/my-app/dev/onprem-dev"
          }
        }
      },
      "staging": {
        "dependsOn": [
          "dev"
        ],
        "autoPromote": false,
        "level": 1,
        "targets": {
          "us-stg": {
            "cluster": "us",
            "namespace": "payments-us-stg",
            "environment": "staging",
            "path": "apps/payments/my-app/staging/us-stg"
          },
          "onprem-stg": {
            "cluster": "onprem",
            "namespace": "payments-onprem-stg",
            "environment": "staging",
            "path": "apps/payments/my-app/staging/onprem-stg"
          }
        }
      },
      "perf": {
        "dependsOn": [
          "dev"
        ],
        "autoPromote": false,
        "level": 1,
        "targets": {
          "us-perf": {
            "cluster": "us",
            "namespace": "payments-us-perf",
            "environment": "perf",
            "path": "apps/payments/my-app/perf/us-perf"
          }
        }
      },
      "prod": {
        "dependsOn": [
          "perf",
          "staging"
        ],
        "autoPromote": false,
        "level": 2,
        "targets": {
          "us-prod": {
            "cluster": "us",
            "namespace": "payments-us-prod",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/us-prod"
          },
          "onprem-prod": {
            "cluster": "onprem",
            "namespace": "payments-onprem-prod",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/onprem-prod"
          }
        }
      }
    },
    "levels": [
      [
        "dev"
      ],
      [
        "perf",
        "staging"
      ],
      [
        "prod"
      ]
    ]
  },
  "worker": {
    "capability": "payments",
    "app": "worker",
    "stages": {
      "dev": {
        "dependsOn": [],
        "autoPromote": true,
        "level": 0,
        "targets": {
          "us-dev": {
            "cluster": "us",
            "namespace": "payments-us-dev",
            "environment": "dev",
            "path": "apps/payments/worker/dev/us-dev"
          }
        }
      },
      "staging": {
        "dependsOn": [
          "dev"
        ],
        "autoPromote": false,
        "level": 1,
        "targets": {
          "us-stg": {
            "cluster": "us",
            "namespace": "payments-us-stg",
            "environment": "staging",
            "path": "apps/payments/worker/staging/us-stg"
          }
        }
      },
      "prod": {
        "dependsOn": [
          "staging"
        ],
        "autoPromote": false,
        "level": 2,
        "targets": {
          "us-prod": {
            "cluster": "us",
            "namespace": "payments-us-prod",
            "environment": "prod",
            "path": "apps/payments/worker/prod/us-prod"
          }
        }
      }
    },
    "levels": [
      [
        "dev"
      ],
      [
        "staging"
      ],
      [
        "prod"
      ]
    ]
  }
}
