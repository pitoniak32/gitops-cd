{
  "my-app": {
    "capability": "payments",
    "app": "my-app",
    "stages": {
      "dev": {
        "dependsOn": [],
        "autoPromote": true,
        "level": 0,
        "targets": {
          "us-east4-dev": {
            "cluster": "in-cluster",
            "namespace": "payments-us-east4-dev",
            "environment": "dev",
            "path": "apps/payments/my-app/dev/us-east4-dev"
          },
          "on-prem-dev": {
            "cluster": "in-cluster",
            "namespace": "payments-on-prem-dev",
            "environment": "dev",
            "path": "apps/payments/my-app/dev/on-prem-dev"
          }
        }
      },
      "staging": {
        "dependsOn": [
          "dev"
        ],
        "autoPromote": false,
        "level": 1,
        "targets": {
          "us-east1-stg": {
            "cluster": "in-cluster",
            "namespace": "payments-us-east1-stg",
            "environment": "staging",
            "path": "apps/payments/my-app/staging/us-east1-stg"
          },
          "on-prem-stg": {
            "cluster": "in-cluster",
            "namespace": "payments-on-prem-stg",
            "environment": "staging",
            "path": "apps/payments/my-app/staging/on-prem-stg"
          }
        }
      },
      "perf": {
        "dependsOn": [
          "dev"
        ],
        "autoPromote": false,
        "level": 1,
        "targets": {
          "us-east1-perf": {
            "cluster": "in-cluster",
            "namespace": "payments-us-east1-perf",
            "environment": "perf",
            "path": "apps/payments/my-app/perf/us-east1-perf"
          },
          "on-prem-perf": {
            "cluster": "in-cluster",
            "namespace": "payments-on-prem-perf",
            "environment": "perf",
            "path": "apps/payments/my-app/perf/on-prem-perf"
          }
        }
      },
      "prod": {
        "dependsOn": [
          "perf",
          "staging"
        ],
        "autoPromote": false,
        "level": 2,
        "targets": {
          "gcp-us-prod": {
            "cluster": "in-cluster",
            "namespace": "payments-gcp-us-prod",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/gcp-us-prod"
          },
          "gcp-eu-prod": {
            "cluster": "in-cluster",
            "namespace": "payments-gcp-eu-prod",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/gcp-eu-prod"
          },
          "on-prem-prod-1": {
            "cluster": "in-cluster",
            "namespace": "payments-on-prem-prod-1",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/on-prem-prod-1"
          },
          "on-prem-prod-2": {
            "cluster": "in-cluster",
            "namespace": "payments-on-prem-prod-2",
            "environment": "prod",
            "path": "apps/payments/my-app/prod/on-prem-prod-2"
          }
        }
      }
    },
    "levels": [
      [
        "dev"
      ],
      [
        "perf",
        "staging"
      ],
      [
        "prod"
      ]
    ]
  },
  "worker": {
    "capability": "payments",
