#!/usr/bin/env bash
# ./gcd: build platform/cli (Go's build cache: ~1s when nothing changed) to .bin/gcd and run it.
# Go comes from mise (.mise.toml pins it) when installed, else PATH.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
go=(go)
if command -v mise >/dev/null 2>&1; then go=(mise exec -C "$root" -- go); fi
"${go[@]}" build -C "$root/platform/cli" -o "$root/.bin/gcd" .
# gcd test runs go itself: put mise's Go on PATH for it
if command -v mise >/dev/null 2>&1; then PATH="$(dirname "$(mise which -C "$root" go)"):$PATH"; export PATH; fi
GCD_ROOT="$root" exec "$root/.bin/gcd" "$@"
